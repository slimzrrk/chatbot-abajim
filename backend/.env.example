# Serveur
NODE_ENV=development
PORT=5001
# URL publique du backend (ex. tunnel ngrok), utilisée pour construire les URLs audio
BASE_URL=http://localhost:5001

# Base de données MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=abajimdb
DB_USERNAME=root
DB_PASSWORD=

# Authentification
JWT_SECRET=change_me

# IA : OpenAI (GPT + Whisper) et ElevenLabs (synthèse vocale)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Service de recommandation (Python / Flask)
RECOMMENDATION_API_URL=http://localhost:8000/api

# TTS de secours (optionnel)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
