      "*.log",
      "*.mp3",
      "*.wav",
      "*.m4a",
      "audio-manifest.json"
    ],
    "ext": "js,json",
    "watch": [
      "public/src/**/*.js",
      "index.js",
      ".env"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
